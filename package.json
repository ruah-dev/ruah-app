{
  "name": "archmap",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "archmap": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx src/cli.ts",
